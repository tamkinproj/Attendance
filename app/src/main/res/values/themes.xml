<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar: the UI is Compose and draws its own TopAppBar. With an
         action-bar theme the framework drew a second, purple "Attendance" bar
         on top of it, which clipped the Compose one underneath. -->
    <style name="Theme.MuslimEduAttendance" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorPrimaryDark">@color/purple_700</item>
        <item name="android:colorAccent">@color/teal_200</item>
    </style>
</resources>
